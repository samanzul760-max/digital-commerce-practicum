generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  STUDENT
}

enum EnrollmentRole {
  STUDENT
  TEACHER
  MENTOR
  ASSISTANT
  HEAD_TEACHER
}

enum AssignmentStatus {
  DRAFT
  PUBLISHED
  CLOSED
  ARCHIVED
}

enum TaskStatus {
  LOCKED
  AVAILABLE
  IN_PROGRESS
  SUBMITTED
  RETURNED
  GRADED
  CLOSED
}

enum RoomMemberRole {
  OWNER
  STUDENT
}

enum StoreStatus {
  ACTIVE
  SUSPENDED
}

enum ProductStatus {
  DRAFT
  ACTIVE
  INACTIVE
}

enum FreightChargeType {
  PIECE
  WEIGHT
}

model Organization {
  id        String         @id @default(cuid())
  name      String
  cohorts   Cohort[]
  rooms     TrainingRoom[]
  classes   Class[]
  createdAt DateTime       @default(now())
}

model TrainingRoom {
  id             String         @id @default(cuid())
  organizationId String
  name           String
  organization   Organization   @relation(fields: [organizationId], references: [id])
  classes        Class[]
  virtualGroups  VirtualGroup[]
  members        RoomMember[]
  stores         Store[]
  setting        TrainingRoomSetting?
  joinApplications JoinApplication[]
  memberInvites  MemberInvite[]
  auditEvents    AuditEvent[]
  templates      PracticumTemplate[]
  competitions   Competition[]

  @@index([organizationId])
}

model Store {
  id               String            @id @default(cuid())
  roomId           String
  ownerId          String
  name             String
  status           StoreStatus       @default(ACTIVE)
  room             TrainingRoom      @relation(fields: [roomId], references: [id], onDelete: Cascade)
  products         Product[]
  freightTemplates FreightTemplate[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@unique([roomId, ownerId])
  @@index([roomId, status])
}

model Product {
  id                String           @id @default(cuid())
  storeId           String
  freightTemplateId String?
  title             String
  category          String
  description       String           @default("")
  status            ProductStatus    @default(DRAFT)
  basePrice         Decimal          @db.Decimal(12, 2)
  store             Store            @relation(fields: [storeId], references: [id], onDelete: Cascade)
  freightTemplate   FreightTemplate? @relation(fields: [freightTemplateId], references: [id], onDelete: SetNull)
  skus              ProductSKU[]
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([storeId, status])
  @@index([freightTemplateId])
  @@index([storeId, updatedAt])
}

model ProductSKU {
  id         String   @id @default(cuid())
  productId  String
  skuCode    String
  name       String
  attributes Json     @default("{}")
  price      Decimal  @db.Decimal(12, 2)
  stock      Int      @default(0)
  enabled    Boolean  @default(true)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([productId, skuCode])
  @@index([productId, enabled])
}

model FreightTemplate {
  id                    String            @id @default(cuid())
  storeId               String
  name                  String
  chargeType            FreightChargeType @default(PIECE)
  firstUnit             Decimal           @default(1) @db.Decimal(10, 2)
  firstFee              Decimal           @db.Decimal(12, 2)
  additionalUnit        Decimal           @default(1) @db.Decimal(10, 2)
  additionalFee         Decimal           @db.Decimal(12, 2)
  freeShippingThreshold Decimal?          @db.Decimal(12, 2)
  isDefault             Boolean           @default(false)
  store                 Store             @relation(fields: [storeId], references: [id], onDelete: Cascade)
  products              Product[]
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  @@unique([storeId, name])
  @@index([storeId, isDefault])
}

model VirtualGroup {
  id        String       @id @default(cuid())
  roomId    String
  name      String
  room      TrainingRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  members   RoomMember[]
  announcements ClassAnnouncement[]
  joinApplications JoinApplication[]
  memberInvites MemberInvite[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@unique([roomId, name])
  @@index([roomId])
}

model RoomMember {
  id                String         @id @default(cuid())
  roomId            String
  displayName       String
  role              RoomMemberRole @default(STUDENT)
  groupId           String?
  isDemo            Boolean        @default(false)
  completionPercent Int            @default(0)
  gradedCount       Int            @default(0)
  avgScore          Int            @default(0)
  skillMetrics      Json           @default("[]")
  planProgress      Json           @default("[]")
  room              TrainingRoom   @relation(fields: [roomId], references: [id], onDelete: Cascade)
  group             VirtualGroup?  @relation(fields: [groupId], references: [id], onDelete: SetNull)
  activityExecutions ActivityExecution[]
  competitionEntries CompetitionEntry[]
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@unique([roomId, displayName])
  @@index([roomId, role])
  @@index([groupId])
}

model Cohort {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  startsAt       DateTime
  endsAt         DateTime
  organization   Organization @relation(fields: [organizationId], references: [id])
  classes        Class[]

  @@unique([organizationId, name])
}

model Class {
  id              String            @id @default(cuid())
  organizationId  String
  roomId          String
  cohortId        String
  name            String
  organization    Organization      @relation(fields: [organizationId], references: [id])
  room            TrainingRoom      @relation(fields: [roomId], references: [id])
  cohort          Cohort            @relation(fields: [cohortId], references: [id])
  enrollments     ClassEnrollment[]
  planAssignments PlanAssignment[]
  announcements   ClassAnnouncement[]
  teachingSessions TeachingSession[]

  @@unique([cohortId, name])
  @@index([roomId])
}

model ClassEnrollment {
  id      String         @id @default(cuid())
  classId String
  userId  String
  role    EnrollmentRole
  active  Boolean        @default(true)
  class   Class          @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@unique([classId, userId])
  @@index([userId, role])
}

model PlanAssignment {
  id              String                         @id @default(cuid())
  classId         String
  planId          String
  title           String
  status          AssignmentStatus               @default(DRAFT)
  availableAt     DateTime
  dueAt           DateTime?
  lateAllowed     Boolean                        @default(false)
  class           Class                          @relation(fields: [classId], references: [id], onDelete: Cascade)
  tasks           StudentTask[]
  dependencies    TaskDependency[]
  idempotencyKeys PlanAssignmentIdempotencyKey[]

  @@index([classId, status])
}

model PlanAssignmentIdempotencyKey {
  id               String         @id @default(cuid())
  userId           String
  method           String
  path             String
  key              String
  planAssignmentId String
  createdAt        DateTime       @default(now())
  planAssignment   PlanAssignment @relation(fields: [planAssignmentId], references: [id], onDelete: Cascade)

  @@unique([userId, method, path, key])
  @@index([planAssignmentId])
}

model TaskDependency {
  id                     String         @id @default(cuid())
  planAssignmentId       String
  activityId             String
  prerequisiteActivityId String
  planAssignment         PlanAssignment @relation(fields: [planAssignmentId], references: [id], onDelete: Cascade)

  @@unique([planAssignmentId, activityId, prerequisiteActivityId])
}

model StudentTask {
  id               String         @id @default(cuid())
  planAssignmentId String
  studentId        String
  activityId       String
  status           TaskStatus     @default(LOCKED)
  availableAt      DateTime
  dueAt            DateTime?
  planAssignment   PlanAssignment @relation(fields: [planAssignmentId], references: [id], onDelete: Cascade)
  submissions      Submission[]

  @@unique([planAssignmentId, studentId, activityId])
  @@index([studentId, status])
}

model ActivityLog {
  id            String   @id @default(cuid())
  userId        String
  studentTaskId String?
  eventType     String
  occurredAt    DateTime @default(now())
  metadata      Json     @default("{}")

  @@index([userId, occurredAt])
  @@index([studentTaskId, occurredAt])
}

model TaskEvent {
  id            String   @id @default(cuid())
  studentTaskId String
  eventType     String
  createdAt     DateTime @default(now())
  payload       Json     @default("{}")

  @@index([studentTaskId, createdAt])
}

model AutoGradeAttempt {
  id            String   @id @default(cuid())
  studentTaskId String
  attempt       Int
  input         Json     @default("{}")
  score         Decimal? @db.Decimal(6, 2)
  result        Json     @default("{}")
  createdAt     DateTime @default(now())

  @@unique([studentTaskId, attempt])
  @@index([studentTaskId, createdAt])
}

model Submission {
  id              String                     @id @default(cuid())
  studentTaskId   String                     @unique
  currentVersion  Int                        @default(0)
  submittedAt     DateTime?
  studentTask     StudentTask                @relation(fields: [studentTaskId], references: [id], onDelete: Cascade)
  versions        SubmissionVersion[]
  grade           Grade?
  idempotencyKeys SubmissionIdempotencyKey[]
}

model SubmissionIdempotencyKey {
  id           String     @id @default(cuid())
  userId       String
  method       String
  path         String
  key          String
  submissionId String
  createdAt    DateTime   @default(now())
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@unique([userId, method, path, key])
  @@index([submissionId])
}

model SubmissionVersion {
  id           String     @id @default(cuid())
  submissionId String
  version      Int
  text         String
  links        Json       @default("[]")
  submittedAt  DateTime   @default(now())
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@unique([submissionId, version])
}

model Grade {
  id           String          @id @default(cuid())
  submissionId String          @unique
  reviewerId   String
  feedback     String
  score        Decimal         @db.Decimal(6, 2)
  gradedAt     DateTime        @default(now())
  submission   Submission      @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  items        GradeItem[]
  revisions    GradeRevision[]
}

model GradeRevision {
  id         String   @id @default(cuid())
  gradeId    String
  revision   Int
  reviewerId String
  feedback   String
  score      Decimal  @db.Decimal(6, 2)
  createdAt  DateTime @default(now())
  grade      Grade    @relation(fields: [gradeId], references: [id], onDelete: Cascade)

  @@unique([gradeId, revision])
  @@index([gradeId, createdAt])
}

model GradeItem {
  id           String  @id @default(cuid())
  gradeId      String
  rubricItemId String
  score        Decimal @db.Decimal(6, 2)
  grade        Grade   @relation(fields: [gradeId], references: [id], onDelete: Cascade)

  @@unique([gradeId, rubricItemId])
}

model User {
  id           String          @id @default(cuid())
  identifier   String          @unique
  displayName  String
  passwordSalt String
  passwordHash String
  role         UserRole
  enabled      Boolean         @default(true)
  roleGrants   UserRoleGrant[]
  authSessions AuthSession[]
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([role, enabled])
}

model UserRoleGrant {
  id        String   @id @default(cuid())
  userId    String
  role      UserRole
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, role])
  @@index([role])
}

model AuthSession {
  id             String   @id @default(cuid())
  userId         String
  tokenHash      String   @unique
  csrfTokenHash  String
  activeRole     UserRole
  organizationId String?
  roomId         String?
  expiresAt      DateTime
  revokedAt      DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
}

model TrainingRoomSetting {
  id             String       @id @default(cuid())
  trainingRoomId String       @unique
  description    String       @default("")
  coverUrl       String?
  teachingMode   String       @default("STANDARD")
  visibility     String       @default("PRIVATE")
  version        Int          @default(1)
  publishedAt    DateTime?
  trainingRoom   TrainingRoom @relation(fields: [trainingRoomId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model ClassAnnouncement {
  id            String        @id @default(cuid())
  classId       String
  targetGroupId String?
  authorId      String
  idempotencyKey String
  title         String
  body          String
  status        String        @default("DRAFT")
  publishedAt   DateTime?
  closedAt      DateTime?
  class         Class         @relation(fields: [classId], references: [id], onDelete: Cascade)
  targetGroup   VirtualGroup? @relation(fields: [targetGroupId], references: [id], onDelete: SetNull)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@unique([classId, authorId, idempotencyKey])
  @@index([classId, status])
  @@index([targetGroupId])
}

model TeachingSession {
  id                String              @id @default(cuid())
  classId           String
  startedById       String
  currentActivityId String?
  status            String              @default("ACTIVE")
  idempotencyKey    String
  startedAt         DateTime            @default(now())
  endedAt           DateTime?
  class             Class               @relation(fields: [classId], references: [id], onDelete: Cascade)
  activityExecutions ActivityExecution[]
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@unique([classId, idempotencyKey])
  @@index([classId, status])
}

model ActivityExecution {
  id                String          @id @default(cuid())
  teachingSessionId String
  memberId          String
  activityId        String
  status            String          @default("NOT_STARTED")
  startedAt         DateTime?
  completedAt       DateTime?
  teachingSession   TeachingSession @relation(fields: [teachingSessionId], references: [id], onDelete: Cascade)
  member            RoomMember      @relation(fields: [memberId], references: [id], onDelete: Cascade)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@unique([teachingSessionId, memberId, activityId])
  @@index([memberId, status])
}

model JoinApplication {
  id             String        @id @default(cuid())
  trainingRoomId String
  targetGroupId  String?
  applicantId    String
  status         String        @default("PENDING")
  idempotencyKey String
  decidedById    String?
  decidedAt      DateTime?
  trainingRoom   TrainingRoom  @relation(fields: [trainingRoomId], references: [id], onDelete: Cascade)
  targetGroup    VirtualGroup? @relation(fields: [targetGroupId], references: [id], onDelete: SetNull)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@unique([trainingRoomId, applicantId, idempotencyKey])
  @@index([trainingRoomId, status])
  @@index([targetGroupId])
}

model MemberInvite {
  id             String        @id @default(cuid())
  trainingRoomId String
  targetGroupId  String?
  invitedById    String
  invitee        String
  inviteCode     String        @unique
  status         String        @default("ACTIVE")
  idempotencyKey String
  expiresAt      DateTime
  revokedAt      DateTime?
  usedAt         DateTime?
  trainingRoom   TrainingRoom  @relation(fields: [trainingRoomId], references: [id], onDelete: Cascade)
  targetGroup    VirtualGroup? @relation(fields: [targetGroupId], references: [id], onDelete: SetNull)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@unique([trainingRoomId, invitedById, idempotencyKey])
  @@index([trainingRoomId, status])
  @@index([targetGroupId])
  @@index([expiresAt])
}

model AuditEvent {
  id             String       @id @default(cuid())
  trainingRoomId String
  actorId        String
  actorRole      String
  entityType     String
  entityId       String
  eventType      String
  metadata       Json         @default("{}")
  occurredAt     DateTime     @default(now())
  trainingRoom   TrainingRoom @relation(fields: [trainingRoomId], references: [id], onDelete: Cascade)

  @@index([trainingRoomId, occurredAt])
  @@index([trainingRoomId, entityType, entityId])
}

model PracticumTemplate {
  id             String        @id @default(cuid())
  trainingRoomId String
  templateKey    String
  name           String
  enabled        Boolean       @default(true)
  configuration  Json          @default("{}")
  trainingRoom   TrainingRoom  @relation(fields: [trainingRoomId], references: [id], onDelete: Cascade)
  competitions   Competition[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@unique([trainingRoomId, templateKey])
  @@index([trainingRoomId, enabled])
}

model Competition {
  id             String             @id @default(cuid())
  trainingRoomId String
  templateId     String?
  createdById    String
  name           String
  description    String             @default("")
  status         String             @default("DRAFT")
  startsAt       DateTime?
  endsAt         DateTime?
  publishedAt    DateTime?
  trainingRoom   TrainingRoom       @relation(fields: [trainingRoomId], references: [id], onDelete: Cascade)
  template       PracticumTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  entries        CompetitionEntry[]
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([trainingRoomId, status])
  @@index([templateId])
}

model CompetitionEntry {
  id            String      @id @default(cuid())
  competitionId String
  memberId      String
  status        String      @default("REGISTERED")
  registeredAt  DateTime    @default(now())
  submittedAt   DateTime?
  competition   Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  member        RoomMember  @relation(fields: [memberId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([competitionId, memberId])
  @@index([memberId, status])
}
