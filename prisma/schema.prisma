generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  STUDENT
}

enum EnrollmentRole {
  STUDENT
  TEACHER
  MENTOR
  ASSISTANT
  HEAD_TEACHER
}

enum AssignmentStatus {
  DRAFT
  PUBLISHED
  CLOSED
  ARCHIVED
}

enum TaskStatus {
  LOCKED
  AVAILABLE
  IN_PROGRESS
  SUBMITTED
  RETURNED
  GRADED
  CLOSED
}

enum RoomMemberRole {
  OWNER
  STUDENT
}

enum StoreStatus {
  ACTIVE
  SUSPENDED
}

enum ProductStatus {
  DRAFT
  ACTIVE
  INACTIVE
}

enum FreightChargeType {
  PIECE
  WEIGHT
}

enum ResourceSource {
  SOFTWARE_CENTER
  SKILL_CAMP
  ENTERPRISE_TASK_LIBRARY
}

enum SandboxType {
  STORE_BASICS
  PRODUCT_MANAGEMENT
  STORE_DECORATION
  MARKETING
  BUSINESS_ANALYTICS
}

enum TrainingRoomType {
  TEACHING
  COMPETITION
  CERTIFICATION
}

enum TaskSectionType {
  WORK_ORDER
  MEDIA
  QUIZ
  SANDBOX
}

enum MediaKind {
  PPT
  VIDEO
  PDF
  IMAGE
  LINK
}

enum QuestionType {
  SINGLE
  MULTIPLE
  TRUE_FALSE
  FILL_BLANK
  SHORT_ANSWER
}

enum SubmissionPartStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  NEEDS_REVIEW
  GRADED
}

model Organization {
  id        String         @id @default(cuid())
  name      String
  cohorts   Cohort[]
  rooms     TrainingRoom[]
  classes   Class[]
  createdAt DateTime       @default(now())
}

model TrainingRoom {
  id               String               @id @default(cuid())
  organizationId   String
  name             String
  type             TrainingRoomType     @default(TEACHING)
  organization     Organization         @relation(fields: [organizationId], references: [id])
  classes          Class[]
  virtualGroups    VirtualGroup[]
  members          RoomMember[]
  stores           Store[]
  setting          TrainingRoomSetting?
  joinApplications JoinApplication[]
  memberInvites    MemberInvite[]
  auditEvents      AuditEvent[]
  templates        PracticumTemplate[]
  competitions     Competition[]

  @@index([organizationId])
}

model Store {
  id               String            @id @default(cuid())
  roomId           String
  ownerId          String
  name             String
  status           StoreStatus       @default(ACTIVE)
  room             TrainingRoom      @relation(fields: [roomId], references: [id], onDelete: Cascade)
  products         Product[]
  freightTemplates FreightTemplate[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@unique([roomId, ownerId])
  @@index([roomId, status])
}

model Product {
  id                String           @id @default(cuid())
  storeId           String
  freightTemplateId String?
  title             String
  category          String
  description       String           @default("")
  status            ProductStatus    @default(DRAFT)
  basePrice         Decimal          @db.Decimal(12, 2)
  store             Store            @relation(fields: [storeId], references: [id], onDelete: Cascade)
  freightTemplate   FreightTemplate? @relation(fields: [freightTemplateId], references: [id], onDelete: SetNull)
  skus              ProductSKU[]
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([storeId, status])
  @@index([freightTemplateId])
  @@index([storeId, updatedAt])
}

model ProductSKU {
  id         String   @id @default(cuid())
  productId  String
  skuCode    String
  name       String
  attributes Json     @default("{}")
  price      Decimal  @db.Decimal(12, 2)
  stock      Int      @default(0)
  enabled    Boolean  @default(true)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([productId, skuCode])
  @@index([productId, enabled])
}

model FreightTemplate {
  id                    String            @id @default(cuid())
  storeId               String
  name                  String
  chargeType            FreightChargeType @default(PIECE)
  firstUnit             Decimal           @default(1) @db.Decimal(10, 2)
  firstFee              Decimal           @db.Decimal(12, 2)
  additionalUnit        Decimal           @default(1) @db.Decimal(10, 2)
  additionalFee         Decimal           @db.Decimal(12, 2)
  freeShippingThreshold Decimal?          @db.Decimal(12, 2)
  isDefault             Boolean           @default(false)
  store                 Store             @relation(fields: [storeId], references: [id], onDelete: Cascade)
  products              Product[]
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  @@unique([storeId, name])
  @@index([storeId, isDefault])
}

model VirtualGroup {
  id               String              @id @default(cuid())
  roomId           String
  name             String
  room             TrainingRoom        @relation(fields: [roomId], references: [id], onDelete: Cascade)
  members          RoomMember[]
  announcements    ClassAnnouncement[]
  joinApplications JoinApplication[]
  memberInvites    MemberInvite[]
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  @@unique([roomId, name])
  @@index([roomId])
}

model RoomMember {
  id                 String              @id @default(cuid())
  roomId             String
  displayName        String
  role               RoomMemberRole      @default(STUDENT)
  groupId            String?
  isDemo             Boolean             @default(false)
  completionPercent  Int                 @default(0)
  gradedCount        Int                 @default(0)
  avgScore           Int                 @default(0)
  skillMetrics       Json                @default("[]")
  planProgress       Json                @default("[]")
  room               TrainingRoom        @relation(fields: [roomId], references: [id], onDelete: Cascade)
  group              VirtualGroup?       @relation(fields: [groupId], references: [id], onDelete: SetNull)
  activityExecutions ActivityExecution[]
  competitionEntries CompetitionEntry[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@unique([roomId, displayName])
  @@index([roomId, role])
  @@index([groupId])
}

model Cohort {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  startsAt       DateTime
  endsAt         DateTime
  organization   Organization @relation(fields: [organizationId], references: [id])
  classes        Class[]

  @@unique([organizationId, name])
}

model Class {
  id               String              @id @default(cuid())
  organizationId   String
  roomId           String
  cohortId         String
  name             String
  organization     Organization        @relation(fields: [organizationId], references: [id])
  room             TrainingRoom        @relation(fields: [roomId], references: [id])
  cohort           Cohort              @relation(fields: [cohortId], references: [id])
  enrollments      ClassEnrollment[]
  planAssignments  PlanAssignment[]
  announcements    ClassAnnouncement[]
  teachingSessions TeachingSession[]

  @@unique([cohortId, name])
  @@index([roomId])
}

model ClassEnrollment {
  id      String         @id @default(cuid())
  classId String
  userId  String
  role    EnrollmentRole
  active  Boolean        @default(true)
  class   Class          @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@unique([classId, userId])
  @@index([userId, role])
}

model PlanAssignment {
  id                String                         @id @default(cuid())
  classId           String
  planId            String
  title             String
  description       String                         @default("")
  templateId        String?
  status            AssignmentStatus               @default(DRAFT)
  availableAt       DateTime
  dueAt             DateTime?
  lateAllowed       Boolean                        @default(false)
  autoScoreWeight   Decimal                        @default(70) @db.Decimal(5, 2)
  manualScoreWeight Decimal                        @default(30) @db.Decimal(5, 2)
  timeLimitMinutes  Int?
  assignmentVersion Int                            @default(1)
  publishedSnapshot Json                           @default("{}")
  publishedAt       DateTime?
  class             Class                          @relation(fields: [classId], references: [id], onDelete: Cascade)
  template          WorkOrderTemplate?             @relation(fields: [templateId], references: [id], onDelete: SetNull)
  tasks             StudentTask[]
  sections          TaskSection[]
  dependencies      TaskDependency[]
  idempotencyKeys   PlanAssignmentIdempotencyKey[]

  @@index([classId, status])
  @@index([templateId])
}

model ResourceCatalogItem {
  id             String         @id @default(cuid())
  source         ResourceSource
  title          String
  summary        String         @default("")
  capabilityTags Json           @default("[]")
  version        Int            @default(1)
  enabled        Boolean        @default(true)
  configuration  Json           @default("{}")
  taskSections   TaskSection[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([source, enabled])
}

model WorkOrderTemplate {
  id                  String           @id @default(cuid())
  organizationId      String
  title               String
  description         String           @default("")
  defaultAutoWeight   Decimal          @default(70) @db.Decimal(5, 2)
  defaultManualWeight Decimal          @default(30) @db.Decimal(5, 2)
  sectionsSnapshot    Json
  createdById         String
  idempotencyKey      String?
  assignments         PlanAssignment[]
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  @@unique([createdById, idempotencyKey])
  @@index([organizationId, title])
}

model TaskSection {
  id            String               @id @default(cuid())
  assignmentId  String
  type          TaskSectionType
  parentId      String?
  resourceId    String?
  title         String
  description   String               @default("")
  sort          Int
  required      Boolean              @default(true)
  weightPercent Decimal              @default(0) @db.Decimal(5, 2)
  config        Json                 @default("{}")
  assignment    PlanAssignment       @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  parent        TaskSection?         @relation("TaskSectionTree", fields: [parentId], references: [id], onDelete: Cascade)
  children      TaskSection[]        @relation("TaskSectionTree")
  resource      ResourceCatalogItem? @relation(fields: [resourceId], references: [id], onDelete: SetNull)
  mediaItems    MediaResource[]
  questions     TaskQuestion[]
  sandboxSpec   SandboxSpec?

  @@unique([assignmentId, sort])
  @@index([assignmentId, type])
  @@index([parentId])
  @@index([resourceId])
}

model MediaResource {
  id          String      @id @default(cuid())
  sectionId   String
  kind        MediaKind
  title       String
  url         String?
  storageKey  String?
  mimeType    String?
  durationSec Int?
  sort        Int
  metadata    Json        @default("{}")
  section     TaskSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@unique([sectionId, sort])
}

model TaskQuestion {
  id          String       @id @default(cuid())
  sectionId   String
  type        QuestionType
  prompt      String
  options     Json         @default("[]")
  answerKey   Json         @default("{}")
  explanation String       @default("")
  points      Decimal      @db.Decimal(6, 2)
  sort        Int
  required    Boolean      @default(true)
  section     TaskSection  @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@unique([sectionId, sort])
  @@index([sectionId, type])
}

model SandboxSpec {
  id          String              @id @default(cuid())
  sectionId   String              @unique
  sandboxType SandboxType
  appKey      String
  version     Int                 @default(1)
  config      Json                @default("{}")
  steps       SandboxStep[]
  rubricItems SandboxRubricItem[]
  section     TaskSection         @relation(fields: [sectionId], references: [id], onDelete: Cascade)
}

model SandboxStep {
  id          String      @id @default(cuid())
  sandboxId   String
  title       String
  instruction String
  sort        Int
  required    Boolean     @default(true)
  fields      Json        @default("[]")
  evidenceKey String?
  sandbox     SandboxSpec @relation(fields: [sandboxId], references: [id], onDelete: Cascade)

  @@unique([sandboxId, sort])
}

model SandboxRubricItem {
  id          String      @id @default(cuid())
  sandboxId   String
  title       String
  description String
  points      Decimal     @db.Decimal(6, 2)
  stepId      String?
  sort        Int
  sandbox     SandboxSpec @relation(fields: [sandboxId], references: [id], onDelete: Cascade)

  @@unique([sandboxId, sort])
}

model PlanAssignmentIdempotencyKey {
  id               String         @id @default(cuid())
  userId           String
  method           String
  path             String
  key              String
  planAssignmentId String
  createdAt        DateTime       @default(now())
  planAssignment   PlanAssignment @relation(fields: [planAssignmentId], references: [id], onDelete: Cascade)

  @@unique([userId, method, path, key])
  @@index([planAssignmentId])
}

model TaskDependency {
  id                     String         @id @default(cuid())
  planAssignmentId       String
  activityId             String
  prerequisiteActivityId String
  planAssignment         PlanAssignment @relation(fields: [planAssignmentId], references: [id], onDelete: Cascade)

  @@unique([planAssignmentId, activityId, prerequisiteActivityId])
}

model StudentTask {
  id               String            @id @default(cuid())
  planAssignmentId String
  studentId        String
  activityId       String
  status           TaskStatus        @default(LOCKED)
  availableAt      DateTime
  dueAt            DateTime?
  planAssignment   PlanAssignment    @relation(fields: [planAssignmentId], references: [id], onDelete: Cascade)
  submissions      Submission[]
  sandboxSession   SandboxSession?
  sandboxSnapshots SandboxSnapshot[]

  @@unique([planAssignmentId, studentId, activityId])
  @@index([studentId, status])
}

model ActivityLog {
  id            String   @id @default(cuid())
  userId        String
  studentTaskId String?
  eventType     String
  occurredAt    DateTime @default(now())
  metadata      Json     @default("{}")

  @@index([userId, occurredAt])
  @@index([studentTaskId, occurredAt])
}

model TaskEvent {
  id            String   @id @default(cuid())
  studentTaskId String
  eventType     String
  createdAt     DateTime @default(now())
  payload       Json     @default("{}")

  @@index([studentTaskId, createdAt])
}

model AutoGradeAttempt {
  id            String   @id @default(cuid())
  studentTaskId String
  attempt       Int
  input         Json     @default("{}")
  score         Decimal? @db.Decimal(6, 2)
  result        Json     @default("{}")
  createdAt     DateTime @default(now())

  @@unique([studentTaskId, attempt])
  @@index([studentTaskId, createdAt])
}

model Submission {
  id              String                     @id @default(cuid())
  studentTaskId   String                     @unique
  currentVersion  Int                        @default(0)
  submittedAt     DateTime?
  studentTask     StudentTask                @relation(fields: [studentTaskId], references: [id], onDelete: Cascade)
  versions        SubmissionVersion[]
  grade           Grade?
  idempotencyKeys SubmissionIdempotencyKey[]
}

model SubmissionIdempotencyKey {
  id           String     @id @default(cuid())
  userId       String
  method       String
  path         String
  key          String
  submissionId String
  createdAt    DateTime   @default(now())
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@unique([userId, method, path, key])
  @@index([submissionId])
}

model SubmissionVersion {
  id               String           @id @default(cuid())
  submissionId     String
  version          Int
  text             String           @default("")
  links            Json             @default("[]")
  artifact         Json             @default("{}")
  operationSummary Json             @default("{}")
  submittedAt      DateTime         @default(now())
  submission       Submission       @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  parts            SubmissionPart[]

  @@unique([submissionId, version])
}

model SubmissionPart {
  id             String               @id @default(cuid())
  versionId      String
  sectionId      String
  status         SubmissionPartStatus @default(NOT_STARTED)
  answer         Json                 @default("{}")
  evidence       Json                 @default("{}")
  autoScore      Decimal?             @db.Decimal(6, 2)
  teacherScore   Decimal?             @db.Decimal(6, 2)
  teacherComment String               @default("")
  version        SubmissionVersion    @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@unique([versionId, sectionId])
  @@index([sectionId, status])
}

model SandboxSession {
  id            String            @id @default(cuid())
  studentTaskId String            @unique
  state         Json              @default("{}")
  startedAt     DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  studentTask   StudentTask       @relation(fields: [studentTaskId], references: [id], onDelete: Cascade)
  snapshots     SandboxSnapshot[]

  @@index([studentTaskId, updatedAt])
}

model SandboxSnapshot {
  id               String         @id @default(cuid())
  sandboxSessionId String
  studentTaskId    String
  sectionId        String?
  sandboxType      SandboxType?
  stepId           String?
  artifact         Json           @default("{}")
  createdAt        DateTime       @default(now())
  sandboxSession   SandboxSession @relation(fields: [sandboxSessionId], references: [id], onDelete: Cascade)
  studentTask      StudentTask    @relation(fields: [studentTaskId], references: [id], onDelete: Cascade)

  @@index([studentTaskId, createdAt])
  @@index([sandboxSessionId, createdAt])
}

model Grade {
  id           String          @id @default(cuid())
  submissionId String          @unique
  reviewerId   String
  feedback     String
  autoScore    Decimal         @default(0) @db.Decimal(6, 2)
  manualScore  Decimal         @default(0) @db.Decimal(6, 2)
  autoWeight   Decimal         @default(70) @db.Decimal(5, 2)
  manualWeight Decimal         @default(30) @db.Decimal(5, 2)
  score        Decimal         @db.Decimal(6, 2)
  gradedAt     DateTime        @default(now())
  releasedAt   DateTime?
  releasedById String?
  submission   Submission      @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  items        GradeItem[]
  revisions    GradeRevision[]

  @@index([releasedAt])
}

model GradeRevision {
  id           String   @id @default(cuid())
  gradeId      String
  revision     Int
  reviewerId   String
  feedback     String
  autoScore    Decimal  @default(0) @db.Decimal(6, 2)
  manualScore  Decimal  @default(0) @db.Decimal(6, 2)
  autoWeight   Decimal  @default(70) @db.Decimal(5, 2)
  manualWeight Decimal  @default(30) @db.Decimal(5, 2)
  score        Decimal  @db.Decimal(6, 2)
  createdAt    DateTime @default(now())
  grade        Grade    @relation(fields: [gradeId], references: [id], onDelete: Cascade)

  @@unique([gradeId, revision])
  @@index([gradeId, createdAt])
}

model GradeItem {
  id           String  @id @default(cuid())
  gradeId      String
  rubricItemId String
  score        Decimal @db.Decimal(6, 2)
  grade        Grade   @relation(fields: [gradeId], references: [id], onDelete: Cascade)

  @@unique([gradeId, rubricItemId])
}

model User {
  id           String          @id @default(cuid())
  identifier   String          @unique
  displayName  String
  passwordSalt String
  passwordHash String
  role         UserRole
  enabled      Boolean         @default(true)
  roleGrants   UserRoleGrant[]
  authSessions AuthSession[]
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([role, enabled])
}

model UserRoleGrant {
  id        String   @id @default(cuid())
  userId    String
  role      UserRole
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, role])
  @@index([role])
}

model AuthSession {
  id             String    @id @default(cuid())
  userId         String
  tokenHash      String    @unique
  csrfTokenHash  String
  activeRole     UserRole
  organizationId String?
  roomId         String?
  expiresAt      DateTime
  revokedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
}

model TrainingRoomSetting {
  id             String       @id @default(cuid())
  trainingRoomId String       @unique
  description    String       @default("")
  coverUrl       String?
  teachingMode   String       @default("STANDARD")
  visibility     String       @default("PRIVATE")
  version        Int          @default(1)
  publishedAt    DateTime?
  trainingRoom   TrainingRoom @relation(fields: [trainingRoomId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model ClassAnnouncement {
  id             String        @id @default(cuid())
  classId        String
  targetGroupId  String?
  authorId       String
  idempotencyKey String
  title          String
  body           String
  status         String        @default("DRAFT")
  publishedAt    DateTime?
  closedAt       DateTime?
  class          Class         @relation(fields: [classId], references: [id], onDelete: Cascade)
  targetGroup    VirtualGroup? @relation(fields: [targetGroupId], references: [id], onDelete: SetNull)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@unique([classId, authorId, idempotencyKey])
  @@index([classId, status])
  @@index([targetGroupId])
}

model TeachingSession {
  id                 String              @id @default(cuid())
  classId            String
  startedById        String
  currentActivityId  String?
  status             String              @default("ACTIVE")
  idempotencyKey     String
  startedAt          DateTime            @default(now())
  endedAt            DateTime?
  class              Class               @relation(fields: [classId], references: [id], onDelete: Cascade)
  activityExecutions ActivityExecution[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@unique([classId, idempotencyKey])
  @@index([classId, status])
}

model ActivityExecution {
  id                String          @id @default(cuid())
  teachingSessionId String
  memberId          String
  activityId        String
  status            String          @default("NOT_STARTED")
  startedAt         DateTime?
  completedAt       DateTime?
  teachingSession   TeachingSession @relation(fields: [teachingSessionId], references: [id], onDelete: Cascade)
  member            RoomMember      @relation(fields: [memberId], references: [id], onDelete: Cascade)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@unique([teachingSessionId, memberId, activityId])
  @@index([memberId, status])
}

model JoinApplication {
  id             String        @id @default(cuid())
  trainingRoomId String
  targetGroupId  String?
  applicantId    String
  status         String        @default("PENDING")
  idempotencyKey String
  decidedById    String?
  decidedAt      DateTime?
  trainingRoom   TrainingRoom  @relation(fields: [trainingRoomId], references: [id], onDelete: Cascade)
  targetGroup    VirtualGroup? @relation(fields: [targetGroupId], references: [id], onDelete: SetNull)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@unique([trainingRoomId, applicantId, idempotencyKey])
  @@index([trainingRoomId, status])
  @@index([targetGroupId])
}

model MemberInvite {
  id             String        @id @default(cuid())
  trainingRoomId String
  targetGroupId  String?
  invitedById    String
  invitee        String
  inviteCode     String        @unique
  status         String        @default("ACTIVE")
  idempotencyKey String
  expiresAt      DateTime
  revokedAt      DateTime?
  usedAt         DateTime?
  trainingRoom   TrainingRoom  @relation(fields: [trainingRoomId], references: [id], onDelete: Cascade)
  targetGroup    VirtualGroup? @relation(fields: [targetGroupId], references: [id], onDelete: SetNull)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@unique([trainingRoomId, invitedById, idempotencyKey])
  @@index([trainingRoomId, status])
  @@index([targetGroupId])
  @@index([expiresAt])
}

model AuditEvent {
  id             String       @id @default(cuid())
  trainingRoomId String
  actorId        String
  actorRole      String
  entityType     String
  entityId       String
  eventType      String
  metadata       Json         @default("{}")
  occurredAt     DateTime     @default(now())
  trainingRoom   TrainingRoom @relation(fields: [trainingRoomId], references: [id], onDelete: Cascade)

  @@index([trainingRoomId, occurredAt])
  @@index([trainingRoomId, entityType, entityId])
}

model PracticumTemplate {
  id             String        @id @default(cuid())
  trainingRoomId String
  templateKey    String
  name           String
  enabled        Boolean       @default(true)
  configuration  Json          @default("{}")
  trainingRoom   TrainingRoom  @relation(fields: [trainingRoomId], references: [id], onDelete: Cascade)
  competitions   Competition[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@unique([trainingRoomId, templateKey])
  @@index([trainingRoomId, enabled])
}

model Competition {
  id             String             @id @default(cuid())
  trainingRoomId String
  templateId     String?
  createdById    String
  name           String
  description    String             @default("")
  status         String             @default("DRAFT")
  startsAt       DateTime?
  endsAt         DateTime?
  publishedAt    DateTime?
  trainingRoom   TrainingRoom       @relation(fields: [trainingRoomId], references: [id], onDelete: Cascade)
  template       PracticumTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  entries        CompetitionEntry[]
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([trainingRoomId, status])
  @@index([templateId])
}

model CompetitionEntry {
  id            String      @id @default(cuid())
  competitionId String
  memberId      String
  status        String      @default("REGISTERED")
  registeredAt  DateTime    @default(now())
  submittedAt   DateTime?
  competition   Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  member        RoomMember  @relation(fields: [memberId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([competitionId, memberId])
  @@index([memberId, status])
}
