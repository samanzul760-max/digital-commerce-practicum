{
  "name": "digital-commerce-practicum",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "db:up": "powershell -ExecutionPolicy Bypass -File scripts/use-docker-postgres.ps1",
    "db:status": "powershell -ExecutionPolicy Bypass -File scripts/use-docker-postgres.ps1 -StatusOnly",
    "dev": "npm run db:up && nuxt dev",
    "dev:direct": "nuxt dev",
    "env:check": "node scripts/ensure-dev-env.js --check",
    "env:ensure": "node scripts/ensure-dev-env.js",
    "build": "nuxt build",
    "typecheck": "nuxi typecheck",
    "test:e2e": "node scripts/warmup-and-test.js",
    "test:e2e:ai": "node scripts/warmup-and-test.js",
    "test:e2e:direct": "playwright test",
    "test:e2e:docker": "powershell -ExecutionPolicy Bypass -File scripts/use-docker-postgres.ps1 -RunE2E",
    "deploy:new-ecs": "python scripts/deploy-new-ecs.py"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "nuxt": "3.21.8",
    "vue": "3.5.39"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@types/node": "26.1.1",
    "prisma": "^6.19.0",
    "typescript": "5.9.3",
    "vue-tsc": "3.3.7"
  },
  "allowScripts": {
    "@prisma/engines@6.19.0": true,
    "prisma@6.19.0": true
  }
}
